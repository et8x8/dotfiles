{
  "allowPty": true,
  "filesystem": {
    "denyRead": [],
    "allowWrite": ["~", "/tmp", "/private/tmp", "/var/folders/_f/", "/private/var/folders/_f/"],
    "denyWrite": []
  },
  "network": {
    "allowedDomains": [
      "127.0.0.1",
      "localhost",
      "anthropic.com",
      "*.anthropic.com",
      "*.datadoghq.com",
      "cache.nixos.org",
      "chatgpt.com",
      "*.chatgpt.com",
      "claude.ai",
      "*.claude.ai",
      "claude.com",
      "*.claude.com",
      "cloudflare.com",
      "*.cloudflare.com",
      "context7.com",
      "*.context7.com",
      "files.pythonhosted.org",
      "github.com",
      "*.github.com",
      "googleapis.com",
      "*.googleapis.com",
      "googleusercontent.com",
      "*.googleusercontent.com",
      "jetify.com",
      "*.jetify.com",
      "npmjs.org",
      "*.openai.com",
      "pypi.org",
      "raw.githubusercontent.com",
      "registry.npmjs.org",
      "search.devbox.sh"
    ],
    "deniedDomains": [],
    "allowAllUnixSockets": true,
    "allowLocalBinding": true
  },
  "enableWeakerNetworkIsolation": true,
  "allowAppleEvents": true
}
