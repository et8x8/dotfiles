{
  "allowPty": true,
  "filesystem": {
    "denyRead": [],
    "allowWrite": ["~", "/var/folders/_f/", "/private/var/folders/_f/"],
    "denyWrite": []
  },
  "network": {
    "allowedDomains": [
      "127.0.0.1",
      "localhost",
      "anthropic.com",
      "*.anthropic.com",
      "*.datadoghq.com",
      "cache.nixos.org",
      "chatgpt.com",
      "*.chatgpt.com",
      "claude.ai",
      "*.claude.ai",
      "claude.com",
      "*.claude.com",
      "context7.com",
      "*.context7.com",
      "files.pythonhosted.org",
      "github.com",
      "*.github.com",
      "npmjs.org",
      "*.openai.com",
      "pypi.org",
      "raw.githubusercontent.com",
      "registry.npmjs.org",
      "search.devbox.sh"
    ],
    "deniedDomains": [],
    "allowUnixSockets": ["~/.config/herdr", "/tmp/claude", "/private/tmp/claude"],
    "allowLocalBinding": true
  },
  "enableWeakerNetworkIsolation": true,
  "allowAppleEvents": true
}
