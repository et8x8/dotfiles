# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=({{ .chezmoi.homeDir }}/.docker/completions $fpath)
autoload -Uz compinit
compinit
# End of Docker CLI completions

# lazygit（~/ghq/bin/lazygit を PATH 解決できるよう bin を追加）
export PATH="$HOME/ghq/bin:$PATH"

# ユーザーローカルバイナリ
export PATH="$HOME/.local/bin:$PATH"

# Default editor
export EDITOR=nvim
export VISUAL=nvim

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY

# Key bindings
bindkey -e

# fzf
source <(fzf --zsh)

# Aliases
alias cdg="cd \$(ghq root)/\$(ghq list | fzf)"
alias vim="nvim"

codex() {
  # nono配下では外側のSandboxを引き継ぎ、内側のnono再適用を避ける
  if [[ -n "${NONO_CAP_FILE:-}" ]]; then
    command codex "$@"
  else
    nono wrap --profile agents --allow-cwd --allow-launch-services -- codex "$@"
  fi
}

claude() {
  # nono配下では外側のSandboxを引き継ぎ、内側のnono再適用を避ける
  if [[ -n "${NONO_CAP_FILE:-}" ]]; then
    command claude "$@"
  else
    nono wrap --profile agents --allow-cwd --allow-launch-services -- claude "$@"
  fi
}

agy() {
  # nono配下では外側のSandboxを引き継ぎ、内側のnono再適用を避ける
  if [[ -n "${NONO_CAP_FILE:-}" ]]; then
    command agy "$@"
  else
    nono wrap --profile agents --allow-cwd --allow-launch-services -- agy "$@"
  fi
}

# chezmoi
source <(chezmoi completion zsh)

# Starship prompt — https://starship.rs/
eval "$(starship init zsh)"

# broot
source {{ .chezmoi.homeDir }}/.config/broot/launcher/bash/br
